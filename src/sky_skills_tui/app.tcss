Screen { background: #0b1020; color: #dae3f2; }
Header { background: #162039; color: #8fe4e3; }
Footer { background: #162039; }
#workspace { padding: 0 1; }
#intro { height: 2; align-vertical: middle; }
#library-title { width: 22; color: #8fe4e3; text-style: bold; }
#project-path { width: 1fr; color: #8796b3; text-align: right; }
#filters, #source-bar, #targets { height: 3; }
#scope { width: 19; margin-right: 1; }
#filter, #source { width: 1fr; margin-right: 1; }
Input, Select { background: #111b30; border: tall #273650; }
Input:focus { border: tall #8fe4e3; }
Button { min-width: 10; margin-right: 1; background: #1b2b44; border: none; }
Button:hover { background: #2b4261; }
Button.-primary { background: #247d86; }
Button.-success { background: #246e59; }
Button.-error { background: #7b354a; }
#targets Label { width: 12; padding-top: 1; color: #8796b3; }
#target-scope { width: 16; margin-right: 1; }
#agents { width: 1fr; }
#copy { width: 18; background: transparent; border: none; }
#summary { height: 2; padding-top: 1; color: #8fe4e3; }
#main { height: 1fr; min-height: 6; }
#list-panel { width: 3fr; border: round #273650; }
#details-panel { width: 2fr; margin-left: 1; border: round #273650; }
#skills { height: 1fr; background: #0f182b; }
DataTable > .datatable--header { background: #1b2b44; color: #8fe4e3; }
DataTable > .datatable--cursor { background: #254455; color: #ffffff; }
#hint { height: 1; color: #8796b3; padding-left: 1; }
#details { padding: 1; }
TabbedContent, TabPane { padding: 0; }
#actions { height: 3; margin-top: 1; }
#log { height: 5; background: #0f182b; border-left: thick #247d86; padding: 0 1; }
#operation { height: 1; color: #8796b3; }
.short #log { height: 2; }
.short #intro { display: none; }
.short #summary { height: 1; padding-top: 0; }
.short #hint { display: none; }
.narrow #details-panel { width: 1fr; }
.narrow #list-panel { width: 2fr; }
ConfirmScreen { align: center middle; background: #000000 65%; }
#confirm-dialog { width: 64; max-height: 90%; height: auto; padding: 1 2; border: round #7b354a; background: #162039; }
#confirm-dialog Static { margin: 1 0; height: auto; max-height: 16; overflow-y: auto; }
#confirm-dialog Horizontal { height: 3; }
#confirm-title { color: #ffb4c5; text-style: bold; }
